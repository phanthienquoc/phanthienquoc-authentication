NODE_ENV=development
PORT=4010
CORS_ORIGINS=https://tce.mrcute.space,https://media.mrcute.space
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=replace-with-at-least-32-random-bytes
MFA_ENCRYPTION_KEY=
JWT_ISSUER=https://auth.mrcute.space
JWT_AUDIENCE=tce-dashboard,media-generation
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSKEY_RP_ID=mrcute.space
PASSKEY_RP_NAME=MrCute
PASSKEY_ORIGIN=https://auth.mrcute.space

# Keycloak access-token verification for NestJS resource endpoints.
# Use the issuer URL exposed by your actual Keycloak reverse proxy.
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=mrcute
KEYCLOAK_ISSUER=http://localhost:8080/realms/mrcute
# Must match the aud claim added to access tokens by a Keycloak audience mapper.
KEYCLOAK_AUDIENCE=nest-api
# Only this browser client may exchange a verified Keycloak identity for an app session.
KEYCLOAK_TCE_CLIENT_ID=tce-dashboard
# Optional comma-separated exact Keycloak sub values allowed to link despite email_verified=false.
# Leave empty by default. Add only subjects independently verified/trusted by an administrator.
KEYCLOAK_TCE_UNVERIFIED_EMAIL_SUBJECTS=
