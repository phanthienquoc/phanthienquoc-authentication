# Current legacy mode remains the default until the OIDC rollout is approved.
NEXT_PUBLIC_AUTH_MODE=legacy
NEXT_PUBLIC_AUTH_API_URL=https://auth.mrcute.space

# Set NEXT_PUBLIC_AUTH_MODE=keycloak only after the realm/client is configured.
# Public values only; never put a Keycloak client secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_KEYCLOAK_URL=https://auth.mrcute.space
NEXT_PUBLIC_KEYCLOAK_REALM=mrcute
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=mr-cute-web
